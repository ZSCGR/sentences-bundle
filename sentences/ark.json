    "length": 22
  },
  {
    "id": 40019,
    "uuid": "4fa70dd8-e721-4a4b-8fc7-ae32d3a69bc5",
    "hitokoto": "过去埋下的悲剧，现在开花结果......而未来的悲剧，我们还有能力去阻止。",
    "type": "c",
    "from": "明日方舟",
    "from_who": "阿米娅",
    "creator": "Antigravity",
    "creator_uid": 0,
    "reviewer": 1,
    "commit_from": "web",
